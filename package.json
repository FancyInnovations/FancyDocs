{
  "name": "fancydocs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "generate-docs": "node scripts/generate-docs.mjs",
    "build": "npm run generate-docs && next build",
    "dev": "npm run generate-docs && next dev",
    "start": "next start",
    "types:check": "fumadocs-mdx && tsc --noEmit",
    "lint": "eslint"
  },
  "dependencies": {
    "fumadocs-core": "16.17.10",
    "fumadocs-mdx": "15.4.10",
    "fumadocs-typescript": "^5.6.0",
    "fumadocs-ui": "16.17.10",
    "lucide-react": "^1.9.0",
    "next": "16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.14.0",
    "eslint-config-next": "16.4.5",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.1.16",
    "typescript": "^7.0.2"
  }
}
