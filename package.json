{
  "name": "fancydocs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "generate-docs": "node scripts/generate-docs.mjs",
    "build": "npm run generate-docs && next build",
    "dev": "npm run generate-docs && next dev",
    "start": "next start",
    "types:check": "fumadocs-mdx && tsc --noEmit",
    "lint": "eslint"
  },
  "dependencies": {
    "fumadocs-core": "16.15.4",
    "fumadocs-mdx": "15.4.0",
    "fumadocs-typescript": "^5.3.0",
    "fumadocs-ui": "16.15.4",
    "lucide-react": "^1.38.0",
    "next": "16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^10.9.1",
    "eslint-config-next": "16.3.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.1.16",
    "typescript": "^7.0.2"
  }
}
