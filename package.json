{
  "name": "fancydocs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "generate-docs": "node scripts/generate-docs.mjs",
    "build": "npm run generate-docs && next build",
    "dev": "npm run generate-docs && next dev",
    "start": "next start",
    "types:check": "fumadocs-mdx && tsc --noEmit",
    "lint": "eslint"
  },
  "dependencies": {
    "fumadocs-core": "16.11.5",
    "fumadocs-mdx": "15.0.11",
    "fumadocs-typescript": "^5.3.0",
    "fumadocs-ui": "16.11.5",
    "lucide-react": "^1.9.0",
    "next": "16.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.2",
    "eslint": "^10.7.0",
    "eslint-config-next": "16.2.10",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.1.16",
    "typescript": "^7.0.2"
  }
}
